rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function hasEmail() { return isSignedIn() && request.auth.token.email is string; }
    function userEmail() { return request.auth.token.email.lower(); }
    function isJdtNurseriesEmail() { return hasEmail() && userEmail().matches('^.+@jdtnurseries\\.com$'); }
    function appRole() { return request.auth.token.app_role; }
    function hasAppRole(role) { return isSignedIn() && appRole() == role; }
    function isOwnerAdmin() {
      return (hasEmail() && (userEmail() == "jeremy@jdtnurseries.com" || userEmail() == "buck@jdtnurseries.com"))
        || hasAppRole("owner_admin");
    }
    function isOfficeOperator() {
      return (hasEmail() && (userEmail() == "jennifer@jdtnurseries.com" || userEmail() == "regina@jdtnurseries.com" || userEmail() == "max@jdtnurseries.com"))
        || hasAppRole("operations_coordinator")
        || hasAppRole("office_admin");
    }
    function isContactOnlyAuthorized() { return hasAppRole("contact_only"); }
    function isAuthorizedUser() { return isOwnerAdmin() || isOfficeOperator() || isJdtNurseriesEmail() || isContactOnlyAuthorized(); }
    function isAdmin() { return isOwnerAdmin(); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function canRead() { return isAuthorizedUser(); }
    function canWrite(id) { return (isOwnerAdmin() || isOfficeOperator()) && isValidId(id); }
    function canSubmitFieldUpdate(id) { return isAuthorizedUser() && isValidId(id); }
    function canDelete(id) { return isAdmin() && isValidId(id); }
    function isAppCollection(collection) {
      return collection in ["jobs", "projects", "workOrders", "projectMaterialItems", "loads", "ranchOaks", "inventoryItems", "equipment", "fleetTelematicsEvents", "crews", "staff", "clients", "locations", "species", "scheduleTasks", "treeRelocationRecords", "alerts", "documents", "syncSources", "syncMappings", "importBatches"];
    }
    match /fieldUpdates/{updateId} {
      allow read: if canRead();
      allow create: if canSubmitFieldUpdate(updateId);
      allow update: if canWrite(updateId);
      allow delete: if canDelete(updateId);
    }
    match /{collection}/{documentId} {
      allow read: if isAppCollection(collection) && canRead();
      allow create: if isAppCollection(collection) && canWrite(documentId);
      allow update: if isAppCollection(collection) && canWrite(documentId);
      allow delete: if isAppCollection(collection) && canDelete(documentId);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
