# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this locally in .env.local and in the Cloud Run service environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Production uses https://app.jdtcommandcenter.com.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://app.jdtcommandcenter.com"

# Google Drive Migration
# Enable Google Drive API and Google Picker API in Google Cloud Console.
# Restrict this API key to your hosted domains and the Google Picker/Drive APIs.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
VITE_GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

# Google Maps Tree Relocation
# Enable Maps JavaScript API in the same Google Cloud project.
# Optional map ID lets the hosted app use your Google Cloud map styling.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
