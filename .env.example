# APP_URL: The URL where this applet is hosted.
# Production uses https://app.jdtcommandcenter.com.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://app.jdtcommandcenter.com"

# Google Maps Tree Relocation
# Enable Maps JavaScript API in the same Google Cloud project.
# Restrict this browser key to app.jdtcommandcenter.com and localhost dev origins.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# ArcGIS Operations Map
# Create an ArcGIS Location Platform browser API key and restrict it to
# https://app.jdtcommandcenter.com plus localhost development origins.
VITE_ARCGIS_API_KEY=
VITE_ARCGIS_ORG_URL=https://jdtnurseries.maps.arcgis.com
VITE_ARCGIS_WEB_MAP_ID=
VITE_ARCGIS_LAYER_JDT_PROJECT_BOUNDARIES_URL=
VITE_ARCGIS_LAYER_JDT_TREE_ASSETS_URL=
VITE_ARCGIS_LAYER_JDT_FINAL_TREE_LOCATIONS_URL=
VITE_ARCGIS_LAYER_JDT_HOLDING_AREAS_URL=
VITE_ARCGIS_LAYER_JDT_WORK_ZONES_URL=
VITE_ARCGIS_LAYER_JDT_ROOT_PRUNE_EVENTS_URL=
VITE_ARCGIS_LAYER_JDT_RELOCATION_WORK_URL=
VITE_ARCGIS_LAYER_JDT_NUTRIENT_CARE_TASKS_URL=
VITE_ARCGIS_LAYER_JDT_EQUIPMENT_LOCATIONS_URL=

# ArcGIS hosted layer writes
# Keep these server-side only in Cloud Run. Do not expose them as VITE_* variables.
# The browser API key can query/display layers; hosted layer edits use this OAuth app credential.
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=
ARCGIS_TOKEN_URL=https://www.arcgis.com/sharing/rest/oauth2/token/
JDT_ARCGIS_WRITE_EMAILS=

# Google Drive Migration
# Planned for the Drive upload/picker feature; not required by the current app shell.
# Enable Google Drive API and Google Picker API in Google Cloud Console.
# Restrict this API key to your hosted domains and the Google Picker/Drive APIs.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
VITE_GOOGLE_DRIVE_UPLOAD_FOLDER_ID=

# Google Calendar Sync
# The Calendar grid imports from this Google Calendar into Firestore scheduleTasks.
# If VITE_GOOGLE_CALENDAR_ID is blank, the app finds the calendar by name after authorization.
VITE_GOOGLE_CALENDAR_NAME="JD Thornton Work Schedule"
VITE_GOOGLE_CALENDAR_ID=

# Planned for future AI workflows; keep server-side only when implemented.
GEMINI_API_KEY=

# Reveal server-side integration
# Keep these server-side only in Cloud Run. Do not expose them as VITE_* variables.
REVEAL_API_BASE_URL=https://fim.api.us.fleetmatics.com
REVEAL_API_USERNAME=
REVEAL_API_PASSWORD=
REVEAL_API_APP_ID=
REVEAL_API_TOKEN_PATH=/token
REVEAL_VEHICLES_PATH=/cmd/v1/vehicles

# Reveal recommended API endpoint paths.
# Fill these from the Reveal API portal once each product API is enabled.
REVEAL_DRIVER_ASSIGNMENTS_PATH=
REVEAL_DRIVER_STATUSES_PATH=
REVEAL_FLEET_INSPECTIONS_PATH=
REVEAL_GEOFENCES_PATH=
REVEAL_NON_POWERED_ASSETS_PATH=
REVEAL_NON_POWERED_ASSET_LOCATIONS_PATH=
REVEAL_VEHICLE_GPS_HISTORY_PATH=
REVEAL_VEHICLE_SEGMENTS_PATH=

# Reveal webhooks.
REVEAL_GPS_WEBHOOK_TOKEN=
REVEAL_ALERT_WEBHOOK_TOKEN=
